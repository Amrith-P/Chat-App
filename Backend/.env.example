# Backend Server Port
PORT=5050

# Client Allowed Origin (Vite App)
CLIENT_URL=http://localhost:5173

# Secret Key for Access JWT Tokens (15 min)
JWT_SECRET=super_secret_jwt_key_chat_app_2026_xyz

# Secret Key for Refresh JWT Tokens (7 days)
REFRESH_TOKEN_SECRET=super_secret_refresh_key_chat_app_2026_abc

# Node Environment
NODE_ENV=development

# Optional PostgreSQL Database URL (Leave blank to use local SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/chatapp
