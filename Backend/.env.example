# Backend Environment Configuration Template

# Server Port (Default: 10000)
PORT=10000

# Node Environment (development | production | test)
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=super_secret_jwt_key_chat_app_2026_xyz

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Database Connection URL (PostgreSQL URL for production, SQLite file path for dev)
DATABASE_URL=postgres://user:password@localhost:5432/chatapp
